exports[`paper cc: claude argv 1`] = `
[
  "--dangerously-skip-permissions",
  "--mcp-config",
  {
    "mcpServers": {
      "paper": {
        "alwaysLoad": true,
        "args": [
          "<main>",
          "paper",
          "mcp",
        ],
        "command": "<exec>",
        "type": "stdio",
      },
    },
  },
  "--strict-mcp-config",
  "--plugin-dir",
  "<tmp>/paper-refs-1i58hcongnxn7",
  "--setting-sources",
  "project,local",
  "--settings",
  {
    "claudeMdExcludes": [
      "/x/**",
    ],
    "editorMode": "vim",
    "enabledPlugins": {
      "frontend-design@claude-plugins-official": true,
      "skill-mention@dotfiles": true,
    },
    "extraKnownMarketplaces": {
      "dotfiles": {
        "source": "x",
      },
    },
    "promptCacheTtl": "5m",
    "subagentPromptCacheTtl": "5m",
    "theme": "dark",
  },
  "--agents",
  {
    "designer": {
      "autoCompactWindow": 100000,
      "description": "Executes a design brief in Paper and reports back with a screenshot path.",
      "model": "haiku",
      "prompt": "sha256:30a716deabc9a3a3 length:9449",
    },
    "director": {
      "description": "Directs design work in Paper through the designer subagent.",
      "model": "opus",
      "prompt": "sha256:6fe752195f0d6094 length:11435",
    },
  },
  "--agent",
  "director",
  "--continue",
  "--resume",
  "abc",
  "--verbose",
]
`;

