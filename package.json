{
	"name": "paper-execute",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"designer": "./dist/cli/designer",
		"draft": "./dist/cli/draft"
	},
	"exports": {
		"./plugin": "./src/plugin/index.ts"
	},
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"check:type": "tsrs --noEmit",
		"check:lint": "biome check .",
		"format": "biome format --write .",
		"build": "bun run build:designer && bun run build:draft",
		"build:designer": "bun build --compile --bytecode --compile-autoload-package-json --compile-autoload-tsconfig src/cli.ts --outfile dist/cli/designer",
		"build:draft": "bun build --compile --bytecode packages/draft/cli/src/main.ts --outfile dist/cli/draft",
		"start": "bun run src/cli.ts paper mcp"
	},
	"dependencies": {
		"@effect/platform-bun": "catalog:",
		"@executor-js/execution": "^1.5.28",
		"@executor-js/plugin-mcp": "^1.5.28",
		"@executor-js/runtime-quickjs": "^1.5.28",
		"@executor-js/sdk": "^1.5.28",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@paper-execute/agent-team": "workspace:*",
		"@paper-execute/draft-atlas": "workspace:*",
		"@paper-execute/draft-cartographer": "workspace:*",
		"@paper-execute/draft-project": "workspace:*",
		"@phosphor-icons/core": "^2.1.1",
		"@standard-schema/spec": "1.1.0",
		"effect": "catalog:",
		"image-size": "^2.0.4",
		"minisearch": "^7.2.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@total-typescript/tsconfig": "^1.0.4",
		"bun-types": "catalog:",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "^6.0.3"
	},
	"patchedDependencies": {
		"@executor-js/plugin-mcp@1.5.28": "patches/@executor-js%2Fplugin-mcp@1.5.28.patch"
	}
}
